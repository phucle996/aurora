ZONE_CONTROL_AUTHORIZER_LISTEN=0.0.0.0:50052
ZONE_CONTROL_TELEMETRY_LISTEN=0.0.0.0:9090
RUST_LOG=info
ZONE_ID=019f3d3e-997d-7894-9236-c5122634cb4f
NATS_ZONE_URL=nats://nats-zone-z1:4222
# Zone NATS is always mTLS + credential scoped; plaintext fallback is forbidden.
NATS_ZONE_TLS_CA=/etc/aurora/nats/ca.crt
NATS_ZONE_TLS_CERT=/etc/aurora/nats/tls.crt
NATS_ZONE_TLS_KEY=/etc/aurora/nats/tls.key
NATS_ZONE_CREDS=/etc/aurora/nats/zone-control-authorizer.creds
NATS_ZONE_CONNECT_TIMEOUT_MS=5000
NATS_ZONE_REQUEST_TIMEOUT_MS=2000
ZONE_CONTROL_AUTHORIZER_TLS_CERT=/etc/aurora/tls/tls.crt
ZONE_CONTROL_AUTHORIZER_TLS_KEY=/etc/aurora/tls/tls.key
ZONE_CONTROL_AUTHORIZER_TLS_CLIENT_CA=/etc/aurora/tls/client-ca.crt
# Secret/Config projection: key id -> base64 raw 32-byte Ed25519 public key.
ZONE_CONTROL_ASSERTION_PUBLIC_KEYS={"zone-control-assertion:v1":"BASE64_PUBLIC_KEY"}
ZONE_ACCESS_CACHE_CAPACITY=100000
ZONE_ACCESS_CACHE_TTL_SECONDS=2
ZONE_ACCESS_READ_TIMEOUT_MS=250
# Local development can explicitly lower this to 1. Production must match the
# file-backed Zone KV replica contract (3 or 5).
ZONE_ACCESS_REQUIRED_REPLICAS=3
ZONE_CONTROL_ASSERTION_REPLAY_CAPACITY=1000000
ZONE_CONTROL_MAX_INFLIGHT_CHECKS=512
