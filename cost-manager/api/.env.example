APP_NAME=cost-manager-api
APP_VERSION=dev
APP_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh
PORT=8084
LOG_LEVEL=info
APP_PUBLIC_DOMAIN=https://cost-manager.aurora.local
APP_TRUSTED_PROXIES=
APP_ALLOWED_ORIGINS=https://localhost,https://cost-manager.aurora.local

# PostgreSQL, Shared Redis, Auth Redis and payment signing records are loaded
# by their capability-scoped Vault connectors.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_TIMEOUT=5s
VAULT_MAX_RETRIES=5

# The embedded Cost Engine must use a different Vault principal. Configure
# exactly one dedicated method: token, AppRole, or Kubernetes role.
VAULT_ENGINE_TOKEN=
VAULT_ENGINE_ROLE_ID=
VAULT_ENGINE_SECRET_ID=
VAULT_ENGINE_KUBERNETES_ROLE=
VAULT_ENGINE_KUBERNETES_JWT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# Optional override; defaults to a process-specific file under the OS temp dir.
COST_ENGINE_READY_FILE=

# The embedded development Engine inherits only non-secret tuning and receives
# VAULT_ENGINE_TOKEN remapped to VAULT_TOKEN at process spawn.
PG_MAX_CONNECTIONS=10
PG_MIN_CONNECTIONS=1
PG_ACQUIRE_TIMEOUT_SECS=5
LOCK_TTL_SECS=25
PG_SSL_MODE=prefer

PAYMENT_PROVIDER=aurora-payment-gateway
PAYMENT_CHECKOUT_BASE_URL=https://payments.aurora.local/checkout
PAYMENT_RETURN_BASE_URL=https://cost-manager.aurora.local/
PAYMENT_MINIMUM_TOP_UP_MICRO_UNITS=1000000
PAYMENT_INTENT_TTL=30m
PAYMENT_REFERRAL_RESERVATION_TTL=24h
PAYMENT_WEBHOOK_TOLERANCE=5m

# Resource-plan relay: local AOF is mandatory; replica ACKs=0 only for single-node dev.
HYPERVISOR_RESOURCE_PLAN_REDIS_CLUSTER=false
HYPERVISOR_RESOURCE_PLAN_REPLICA_ACKS=1
HYPERVISOR_RESOURCE_PLAN_DURABLE_WAIT=2s
