VAULT_ADDR=http://vault:8200
# PostgreSQL, Shared Redis and Auth Redis records are read by their connectors.
VAULT_TOKEN=

PAYMENT_PROVIDER=aurora-payment-gateway
PAYMENT_CHECKOUT_BASE_URL=https://payments.example.com/checkout
PAYMENT_RETURN_BASE_URL=https://cost-manager.example.com/
# Signing secrets are read from secret/data/integrations/payment/cost-manager-api
# using the Cost Manager Vault policy.
PAYMENT_MINIMUM_TOP_UP_MICRO_UNITS=1000000
PAYMENT_INTENT_TTL=30m
PAYMENT_REFERRAL_RESERVATION_TTL=24h
PAYMENT_WEBHOOK_TOLERANCE=5m
