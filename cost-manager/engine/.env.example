# Standalone Cost Engine development contract. Compose normally starts the
# embedded Engine through Cost Manager API with a distinct Vault identity.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_TIMEOUT_SECS=5
VAULT_MAX_RETRIES=5

CLICKHOUSE_URL=http://clickhouse:8123
PG_MAX_CONNECTIONS=10
PG_MIN_CONNECTIONS=1
PG_ACQUIRE_TIMEOUT_SECS=5
SCAN_INTERVAL_SECS=30
LOCK_TTL_SECS=25
BLOCK_KEY_TTL_SECS=2592000
# Keep false until report-driven settlement has passed its cutover gate. When
# true, Cost Engine consumes the validated JO Redis Stream handoff instead of
# polling Central ClickHouse for storage egress.
STORAGE_REPORT_SETTLEMENT_ENABLED=false
PG_SSL_MODE=prefer
