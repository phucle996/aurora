# Standalone Cost Engine development contract. Compose normally starts the
# embedded Engine through Cost Manager API with a distinct Vault identity.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_TIMEOUT_SECS=5
VAULT_MAX_RETRIES=5

PG_MAX_CONNECTIONS=10
PG_MIN_CONNECTIONS=1
PG_ACQUIRE_TIMEOUT_SECS=5
LOCK_TTL_SECS=25
PG_SSL_MODE=prefer
