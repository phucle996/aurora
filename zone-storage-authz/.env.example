ZONE_STORAGE_AUTHZ_LISTEN=0.0.0.0:50052
ZONE_ID=019f3d3e-997d-7894-9236-c5122634cb4f
NATS_ZONE_URL=nats://nats-zone-z1:4222
# Production must set the NATS TLS/credential paths below.
NATS_ZONE_TLS_CA=/etc/aurora/nats/ca.crt
NATS_ZONE_TLS_CERT=/etc/aurora/nats/tls.crt
NATS_ZONE_TLS_KEY=/etc/aurora/nats/tls.key
NATS_ZONE_CREDS=/etc/aurora/nats/zone-storage-authz.creds
ZONE_STORAGE_AUTHZ_TLS_CERT=/etc/aurora/tls/tls.crt
ZONE_STORAGE_AUTHZ_TLS_KEY=/etc/aurora/tls/tls.key
ZONE_STORAGE_AUTHZ_TLS_CLIENT_CA=/etc/aurora/tls/client-ca.crt
# Secret/Config projection: key id -> base64 raw 32-byte Ed25519 public key.
STORAGE_ASSERTION_PUBLIC_KEYS={"storage-assertion:v1":"BASE64_PUBLIC_KEY"}
STORAGE_ACCESS_CACHE_CAPACITY=100000
STORAGE_ACCESS_CACHE_TTL_SECONDS=2
STORAGE_ASSERTION_REPLAY_CAPACITY=1000000

