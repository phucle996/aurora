# ═══════════════════════════════════════
# ACR Service - Environment Configuration
# ═══════════════════════════════════════

# gRPC Server Port
ACR_GRPC_PORT=50051

# Redis L2 Connection URL (Session Storage)
REDIS_URL=redis://127.0.0.1:6379

# JWT Secret Key — BẮT BUỘC thay đổi trên Production!
JWT_SECRET=super-secure-secret-key-change-me-in-production

# Session TTL (giây) — Thời gian sống tối đa của Access Session
SESSION_TTL_SECS=1800

# Refresh Threshold (giây) — Ngưỡng kích hoạt Trinity Refresh
REFRESH_THRESHOLD_SECS=900

# OpenTelemetry Collector Endpoint (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Log Level (debug | info | warn | error)
APP_LOG_LEVEL=info
