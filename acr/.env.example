# ═══════════════════════════════════════
# ACR Service - Environment Configuration
# ═══════════════════════════════════════

# gRPC Server Port
ACR_GRPC_PORT=50051

# Security-State Redis: session/alias/nonce/rate-limit, production dùng HA+AOF+noeviction.
AUTH_REDIS_URL=redis://127.0.0.1:6379

# Shared rebuildable cache Redis: zone/config catalog.
CACHE_REDIS_URL=redis://127.0.0.1:6380

# Fixed HTTPS target origin cho Cost authorization-code redirect.
BILLING_CONSOLE_ORIGIN=https://cost-manager.aurora.local

# JWT Secret Key — BẮT BUỘC thay đổi trên Production!
JWT_SECRET=super-secure-secret-key-change-me-in-production

# Session TTL (giây) — Thời gian sống tối đa của Access Session
SESSION_TTL_SECS=1800

# Refresh Threshold (giây) — Ngưỡng kích hoạt Trinity Refresh
REFRESH_THRESHOLD_SECS=900

# OpenTelemetry Collector Endpoint (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Log Level (debug | info | warn | error)
APP_LOG_LEVEL=info
