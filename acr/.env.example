# ═══════════════════════════════════════
# ACR Service - Environment Configuration
# ═══════════════════════════════════════

# gRPC Server Port
ACR_GRPC_PORT=50051

# Redis connection credentials are loaded directly from Vault at startup.
# Keep only the app-specific Vault bootstrap identity outside Vault.
VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN is development-only; production uses AppRole/Kubernetes auth.
VAULT_TOKEN=

# Dedicated asymmetric Vault key for the private Central-to-Zone control
# boundary. Missing values fail ACR startup.
VAULT_ZONE_CONTROL_ASSERTION_KEY_PATH=transit/keys/zone-control-assertion
VAULT_ZONE_CONTROL_ASSERTION_KEY_ID=zone-control-assertion:v1

# Fixed HTTPS target origin cho Cost authorization-code redirect.
BILLING_CONSOLE_ORIGIN=https://cost-manager.aurora.local

# JWT Secret Key — BẮT BUỘC thay đổi trên Production!
JWT_SECRET=super-secure-secret-key-change-me-in-production

# Session TTL (giây) — Thời gian sống tối đa của Access Session
SESSION_TTL_SECS=1800

# Refresh Threshold (giây) — Ngưỡng kích hoạt Trinity Refresh
REFRESH_THRESHOLD_SECS=900

# OpenTelemetry Collector Endpoint (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# [DEV-ONLY]: The local Cloud Console and Google/GitHub callback use
# https://localhost. Production must replace this with the verified HTTPS
# Cloud Console origin; do not use localhost outside development.
APP_ALLOWED_ORIGINS=https://cloud.aurora.local,https://localhost

# OAuth providers are disabled by default. These are the only provider-specific
# environment flags. When enabled, ACR reads one complete provider record from
# the fixed Vault path `secret/data/acr/oauth/{google|github}` at startup and
# keeps the bounded runtime copy in memory. The Vault record must contain
# callback_url, client_id, client_secret and scope. Do not put any of these
# values in this file.
OAUTH_GOOGLE_ENABLED=false
OAUTH_GITHUB_ENABLED=false
# Seed or rotate either provider through the single Vault entrypoint:
# ../controlplane/dev/vault/vault-bootstrap.sh -o -t '<vault-token>'

# Log Level (debug | info | warn | error)
APP_LOG_LEVEL=info
