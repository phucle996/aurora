# ACR owns this environment contract. Docker Compose injects only this file
# into the ACR container.
TZ=Asia/Ho_Chi_Minh
ACR_GRPC_PORT=50051
APP_LOG_LEVEL=info

# Dev only. Production should replace VAULT_TOKEN with AppRole or Kubernetes
# auth carrying the same least-privilege ACR policy.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_KUBERNETES_ROLE=
VAULT_KUBERNETES_JWT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
VAULT_TRANSIT_KEY_PATH=transit/keys/jwt-signer
VAULT_ZONE_CONTROL_ASSERTION_KEY_PATH=transit/keys/zone-control-assertion
VAULT_ZONE_CONTROL_ASSERTION_KEY_ID=zone-control-assertion:v1
VAULT_TOTP_KEY_PATH=totp/keys/admin
VAULT_ADMIN_API_KEY_PATH=secret/data/admin/api-key
VAULT_TIMEOUT_SECS=5
VAULT_MAX_RETRIES=3

# Provider secrets, callbacks and scopes remain in Vault.
OAUTH_GOOGLE_ENABLED=false
OAUTH_GITHUB_ENABLED=false

SESSION_TTL_SECS=1800
REFRESH_THRESHOLD_SECS=900
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
BILLING_CONSOLE_ORIGIN=https://cost-manager.aurora.local
APP_ALLOWED_ORIGINS=https://adminui.aurora.local,https://adminui-dev.aurora.local,https://cloud.aurora.local,https://localhost,https://cost-manager.aurora.local
