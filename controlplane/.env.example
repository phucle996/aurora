# Controlplane bootstrap environment.
# PostgreSQL/Redis credentials are not configured here; connectors read their
# capability-scoped records directly from Vault before creating clients.
APP_TIMEZONE=UTC
VAULT_ADDR=http://vault:8200
# Dev only: use a token issued with controlplane-connections-read. Production
# uses VAULT_KUBERNETES_ROLE or AppRole with the same least-privilege policy.
VAULT_TOKEN=
