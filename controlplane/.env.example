# Controlplane development environment. Docker Compose injects this file into
# Controlplane only; every other app owns a separate app-scoped .env.
APP_NAME=controlplane
APP_VERSION=dev
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_HTTP_PORT=8080
APP_PUBLIC_DOMAIN=
APP_TRUSTED_PROXIES=
APP_ALLOWED_ORIGINS=https://adminui.aurora.local,https://adminui-dev.aurora.local,https://cloud.aurora.local
APP_OAUTH_ALLOWED_SCOPES=profile,email,offline_access

OTEL_ENABLED=true
OTEL_FAIL_STRATEGY=fail_open
OTEL_EXPORTER_TYPE=otlpgrpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRICS_EXEMPLAR_FILTER=trace_based
OTEL_EXPORT_TIMEOUT=5s
OTEL_BSP_SCHEDULE_DELAY=2s
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_MAX_QUEUE_SIZE=2048

# PostgreSQL/Redis credentials are capability-scoped Vault records. Only this
# workload's bootstrap identity is present here.
VAULT_ADDR=http://vault:8200
# Set a local bootstrap token or use AppRole/Kubernetes auth; never commit it.
VAULT_TOKEN=
VAULT_TIMEOUT=5s
VAULT_MAX_RETRIES=5

KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092
KAFKA_SECURITY_PROTOCOL=plaintext
KAFKA_IAM_VERIFICATION_TOPIC=aurora.iam.account-verification.v1

REDIS_DURABLE_REPLICA_ACKS=0
REDIS_DURABLE_WAIT=2s

