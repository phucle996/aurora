    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Queue pressure and batches already handed to JMAP.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (zone_id) (mail_pending_items{zone_id=~\"$zone_id\"} and on (zone_id, hostname) topk by (zone_id) (1, mail_operational_observed_unix_seconds{zone_id=~\"$zone_id\"}))",
          "legendFormat": "pending {{zone_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (zone_id) (mail_in_flight_batches{zone_id=~\"$zone_id\"} and on (zone_id, hostname) topk by (zone_id) (1, mail_operational_observed_unix_seconds{zone_id=~\"$zone_id\"}))",
          "legendFormat": "in-flight {{zone_id}}",
          "refId": "B"
        }
      ],
      "title": "Queue and in-flight batches",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Fresh, fenced consumer slots observed in Zone KV.",
      "fieldConfig": {
