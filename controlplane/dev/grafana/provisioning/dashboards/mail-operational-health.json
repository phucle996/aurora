    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Low-cardinality health observation failures grouped by bounded error code.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "errors",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
