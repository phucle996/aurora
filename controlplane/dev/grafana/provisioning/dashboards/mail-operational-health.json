      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (zone_id) (mail_active_consumer_slots{zone_id=~\"$zone_id\"} and on (zone_id, hostname) topk by (zone_id) (1, mail_operational_observed_unix_seconds{zone_id=~\"$zone_id\"}))",
          "legendFormat": "{{zone_id}}",
          "refId": "A"
