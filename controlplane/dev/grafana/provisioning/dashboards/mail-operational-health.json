          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (zone_id, error_code) (rate(mail_operational_observation_error_total{zone_id=~\"$zone_id\"}[5m]))",
          "legendFormat": "{{zone_id}} / {{error_code}}",
          "refId": "A"
        }
      ],
      "title": "Observation errors / second",
      "type": "timeseries"
