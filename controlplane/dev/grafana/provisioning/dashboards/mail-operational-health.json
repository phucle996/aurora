  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(mail_service_health_state, zone_id)",
        "hide": 0,
        "includeAll": true,
        "label": "Zone",
        "multi": true,
        "name": "zone_id",
        "options": [],
        "query": {
          "query": "label_values(mail_service_health_state, zone_id)",
          "refId": "VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
