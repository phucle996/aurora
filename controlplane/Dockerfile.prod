# syntax=docker/dockerfile:1.7

# ============================================================================
# 🏗️ STAGE 1: BUILDER - BIÊN DỊCH BẢN RUST/GO TĨNH VỚI CACHE LAYER TỐI ƯU
# ============================================================================
# [COMMENT]: Sử dụng Go 1.26 Bookworm làm builder stage có đầy đủ công cụ biên dịch
FROM golang:1.26-bookworm AS builder
WORKDIR /src

# [COMMENT]: Cache Go modules giữa các lượt build để tăng tốc tối đa thời gian biên dịch
RUN --mount=type=cache,target=/go/pkg/mod/ \
    --mount=type=bind,source=go.mod,target=go.mod \
    --mount=type=bind,source=go.sum,target=go.sum \
    go mod download

# [COMMENT]: Biên dịch tĩnh Go binary (CGO_ENABLED=0) loại bỏ hoàn toàn phụ thuộc C-library
# Cắt bỏ symbol table (-s -w) giúp giảm kích thước binary và bảo mật
RUN --mount=type=cache,target=/go/pkg/mod/ \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=bind,source=.,target=. \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags='-s -w' -o /out/controlplane ./cmd/server

# ============================================================================
# 🚀 STAGE 2: RUNNER - CONTAINER DISTROLESS TỐI GIẢN (ZERO SHELL & NON-ROOT)
# ============================================================================
# [COMMENT]: Chuyển sang Google Distroless Static Debian 12 Non-Root
# Image này không có shell (/bin/sh, /bin/bash), không package manager (apt/dpkg)
# Giúp loại bỏ hoàn toàn attack surface của các lỗi CVE liên quan đến OS shell & utilities.
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

# [COMMENT]: Sao chép Go binary đã biên dịch tĩnh từ stage builder sang runtime path
COPY --from=builder /out/controlplane /usr/local/bin/controlplane

# [COMMENT]: Đặt thư mục làm việc tiêu chuẩn cho controlplane
WORKDIR /var/lib/controlplane

# [COMMENT]: Sử dụng user nonroot có sẵn trong distroless (UID 65532:65532) tuân thủ chuẩn Cloud-Native Security
USER 65532:65532

# [COMMENT]: Expose các cổng dịch vụ gRPC, HTTP API Gateway và TLS Management
EXPOSE 8080 9090 9443

# [COMMENT]: Khởi chạy ứng dụng trực tiếp không qua shell wrapper
ENTRYPOINT ["/usr/local/bin/controlplane"]