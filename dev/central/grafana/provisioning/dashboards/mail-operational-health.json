        "x": 0,
        "y": 5
      },
      "id": 14,
      "panels": [],
      "title": "JMAP Probe Latency & Performance",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Local JMAP delivery probe response latency percentiles (p50, p90, p99).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "id": 15,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(mail_jmap_probe_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 Latency",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.90, sum by (le) (rate(mail_jmap_probe_duration_seconds_bucket[5m])))",
          "legendFormat": "p90 Latency",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mail_jmap_probe_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 Latency",
          "refId": "C"
        }
      ],
      "title": "JMAP Probe Response Time (p50 / p90 / p99)",
      "type": "timeseries"
    },
