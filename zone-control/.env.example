ZONE_CONTROL_LISTEN=0.0.0.0:8080
ZONE_CONTROL_ORCHESTRATOR_ENABLED=true
# Starts Zone-local hourly metering -> JetStream report buffer -> Kafka.
ZONE_CONTROL_METERING_ENABLED=true
RUST_LOG=info
ZONE_ID=019f3d3e-997d-7894-9236-c5122634cb4f
ZONE_PUBLIC_BASE_URL=https://storage.zone-z1.aurora.local
ZONE_TRANSFER_TICKET_TTL_SECONDS=60
ZONE_TRANSFER_KV_REQUIRED_REPLICAS=3
# Gate B distributed assignment: work-unit count is intentionally greater than
# the normal replica count so control duties can rebalance without a global leader.
ZONE_CONTROL_ASSIGNMENT_SHARDS=16
ZONE_CONTROL_MAX_CONCURRENCY=32
ZONE_CONTROL_CAPACITY_WEIGHT=1
STORAGE_SCAN_INTERVAL_SECONDS=3600
STORAGE_SCAN_BATCH_SIZE=32
STORAGE_SCAN_BATCH_PAUSE_MS=250
METERING_WINDOW_SECONDS=3600
METERING_LATE_GRACE_SECONDS=300
METERING_PUBLISH_INTERVAL_SECONDS=30
METERING_MAX_BACKFILL_WINDOWS=24
NATS_ZONE_URL=nats://nats-zone-z1:4222
NATS_ZONE_TLS_CA=/etc/aurora/nats/tls/ca.crt
NATS_ZONE_TLS_CERT=/etc/aurora/nats/tls/zone-control.crt
NATS_ZONE_TLS_KEY=/etc/aurora/nats/tls/zone-control.key
NATS_ZONE_CREDS=/etc/aurora/nats/zone-control.creds
NATS_ZONE_REQUEST_TIMEOUT_MS=2000

# Zone Control metadata/control workflows use the same durable Kafka boundary as
# Dataplane. The publisher and control duties never send raw access logs.
CLICKHOUSE_URL=http://zone-clickhouse:8123
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092
KAFKA_SECURITY_PROTOCOL=plaintext
KAFKA_TOPIC_PREFIX=aurora
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_CA_CERT=
