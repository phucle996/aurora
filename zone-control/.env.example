ZONE_CONTROL_LISTEN=0.0.0.0:8080
ZONE_CONTROL_ORCHESTRATOR_ENABLED=false
# Keep false until Zone-local reconciliation and Cost Engine cutover gates are
# approved. True starts ClickHouse aggregation -> JetStream outbox -> Kafka.
ZONE_CONTROL_METERING_ENABLED=false
RUST_LOG=info
ZONE_ID=019f3d3e-997d-7894-9236-c5122634cb4f
ZONE_PUBLIC_BASE_URL=https://storage.zone-z1.aurora.local
ZONE_TRANSFER_TICKET_TTL_SECONDS=60
ZONE_TRANSFER_KV_REQUIRED_REPLICAS=3
NATS_ZONE_URL=nats://nats-zone-z1:4222
NATS_ZONE_TLS_CA=/etc/aurora/nats/ca.crt
NATS_ZONE_TLS_CERT=/etc/aurora/nats/tls.crt
NATS_ZONE_TLS_KEY=/etc/aurora/nats/tls.key
NATS_ZONE_CREDS=/etc/aurora/nats/zone-control.creds
NATS_ZONE_REQUEST_TIMEOUT_MS=2000

# Used only when ZONE_CONTROL_METERING_ENABLED=true. The publisher accepts the
# same Kafka security variables as Dataplane and never sends raw access logs.
CLICKHOUSE_URL=http://zone-clickhouse:8123
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092
KAFKA_SECURITY_PROTOCOL=plaintext
KAFKA_TOPIC_PREFIX=aurora
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_CA_CERT=
