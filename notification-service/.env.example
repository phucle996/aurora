# Notification Service owns this environment contract. Shared Redis connection
# credentials are loaded from the app-scoped Vault record.
TZ=Asia/Ho_Chi_Minh
APP_PORT=8083

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_TIMEOUT_MS=5000
VAULT_MAX_RETRIES=5

CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=
CENTRIFUGO_REQUEST_TIMEOUT_MS=5000

# Central Scylla endpoint, keyspace, credentials and TLS material are
# resolved from the fixed Notification Scylla capability record in Vault.
SCYLLA_REPLICATION_FACTOR=1
SCYLLA_AUTO_SCHEMA=true
SCYLLA_CONNECT_TIMEOUT_MS=5000
SCYLLA_REQUEST_TIMEOUT_MS=3000

TIMELINE_ACTIVITY_RETENTION_DAYS=365
TIMELINE_INBOX_RETENTION_DAYS=180
TIMELINE_MAX_PAGE_SIZE=50
TIMELINE_MAX_MONTH_SCAN=24

NOTIFICATION_REDIS_CONNECT_TIMEOUT_MS=5000
NOTIFICATION_AUTH_TIMEOUT_MS=5000
NOTIFICATION_AUTH_MAX_PENDING=8192
NOTIFICATION_REDIS_RECONNECT_INITIAL_MS=500
NOTIFICATION_REDIS_RECONNECT_MAX_MS=30000
NOTIFICATION_STREAM_BATCH_SIZE=16
NOTIFICATION_STREAM_CLAIM_IDLE_MS=30000
NOTIFICATION_RECONNECT_INITIAL_MS=500
NOTIFICATION_RECONNECT_MAX_MS=30000
NOTIFICATION_SHUTDOWN_TIMEOUT_MS=10000

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
