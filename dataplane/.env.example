# One Zone-scoped Dataplane contract. Every replica in the same Zone receives
# this file; another Zone must use a different file and workload identity.
ZONE_ID=019f3d3e-997d-7894-9236-c5122634cb4f
TZ=Asia/Ho_Chi_Minh
APP_LOG_LEVEL=info
APP_SHUTDOWN_TIMEOUT=15s
METRICS_PORT=2112

KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092
KAFKA_SECURITY_PROTOCOL=plaintext
KAFKA_TOPIC_PREFIX=aurora
KAFKA_MAX_JOB_ATTEMPTS=5

# Required Zone-local, read-only mount. Do not place private key bytes in this
# env file; every replica in the Zone must mount the same rotation keyring.
JOB_PAYLOAD_PRIVATE_KEYS_FILE=/run/secrets/aurora/job-payload-keys.json

# Zone-local Kubernetes executor. In-cluster defaults are used in deployed
# pods; the token and CA are mounted service-account files and are never put
# into the encrypted customer command or a Controlplane record.
KUBERNETES_API_URL=https://kubernetes.default.svc
KUBERNETES_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBERNETES_CA_CERT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
KUBERNETES_POLL_INTERVAL_MS=1000
KUBERNETES_READINESS_CAP_SECONDS=3600

NATS_ZONE_URL=nats://nats-zone-z1:4222
# Zone KV uses the shared development CA, a scoped NATS credential, and a
# client certificate. Production projects the same paths from Kubernetes
# Secrets; no plaintext or server-only TLS fallback is allowed for this bus.
NATS_ZONE_TLS_CA=/run/secrets/aurora/nats-zone/ca.crt
NATS_ZONE_CREDS=/run/secrets/aurora/nats-zone-dataplane.creds
NATS_ZONE_TLS_CERT=/run/secrets/aurora/nats-zone/dataplane.crt
NATS_ZONE_TLS_KEY=/run/secrets/aurora/nats-zone/dataplane.key
NATS_ZONE_KV_REPLICAS=1

# Zone workloads export only to the same-Zone collector. Central observability
# is a separate deployment and is not a Dataplane fallback.
OTEL_EXPORTER_OTLP_ENDPOINT=http://zone-otel-collector:4317
OTEL_TRACE_SAMPLE_RATIO=0.25
OTEL_BSP_MAX_QUEUE_SIZE=8192
MAIL_RUNTIME_TELEMETRY_INTERVAL_MS=5000
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BSP_EXPORT_TIMEOUT=5000

MIN_WORKERS=1
MAX_WORKERS=100
JOB_QUEUE_CAPACITY=100

HYPERVISOR_IMAGE_S3_ENDPOINT=http://minio:9000
HYPERVISOR_IMAGE_S3_BUCKET=aurora-hypervisor-images
HYPERVISOR_IMAGE_S3_ACCESS_KEY=
HYPERVISOR_IMAGE_S3_SECRET_KEY=
PROXMOX_IMAGE_SOURCE_STORAGE=local

STALWART_JMAP_URL=http://stalwart:8080/jmap
STALWART_JMAP_ACCOUNT_ID=b
STALWART_JMAP_IDENTITY_ID=b
STALWART_JMAP_MAILBOX_ID=e
STALWART_JMAP_USERNAME=admin@example.org
STALWART_JMAP_PASSWORD=
MAIL_SENDER_PROFILE_ID=platform-default
MAIL_SENDER_VERSION=1
MAIL_SENDER_ADDRESS=admin@example.org
MAIL_STREAM_ALLOW_PLAINTEXT_KAFKA=true
APP_VERSION=dev
