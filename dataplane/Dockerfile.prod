# syntax=docker/dockerfile:1.7

# [COMMENT]: Build mc từ exact upstream release trên Go toolchain đã vá. Không copy image `latest`:
# binary published ở đó mang Go dependency graph riêng và không thể được Rust lockfile kiểm soát.
FROM golang:1.26.5-trixie AS mc-builder
ARG MC_VERSION=RELEASE.2025-08-13T08-35-41Z
WORKDIR /src/mc
RUN git clone --branch "$MC_VERSION" --depth 1 https://github.com/minio/mc.git . \
    && go get github.com/prometheus/prometheus@v0.311.3 \
        golang.org/x/crypto@v0.52.0 \
        golang.org/x/net@v0.55.0 \
        golang.org/x/text@v0.39.0 \
        google.golang.org/grpc@v1.82.1 \
    && go mod tidy \
    && go mod verify \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/mc .

# ============================================================================
# 🏗️ STAGE 1: BUILDER - BIÊN DỊCH BẢN RUST AURORA-DATAPLANE
# ============================================================================
# [COMMENT]: Build context phải là monorepo root để build.rs đọc canonical
# proto/ mà không cần service-local proto copy.
# [COMMENT]: Sử dụng rust:bookworm chính thức làm môi trường builder có đầy đủ công cụ biên dịch C/C++ và Protobuf
FROM rust:bookworm AS builder

# [COMMENT]: Cài đặt protobuf-compiler phục vụ biên dịch gRPC/Protobuf schemas trong Dataplane
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler curl && rm -rf /var/lib/apt/lists/*
WORKDIR /src/dataplane

# [COMMENT]: Pre-warm dependency cache bằng dummy main.rs để tối ưu layer caching của Docker
COPY dataplane/Cargo.toml dataplane/Cargo.lock ./
RUN mkdir -p src \
    && echo "fn main() {}" > src/main.rs \
    && cargo build --release --bin aurora-dataplane \
    && rm -rf src \
    target/release/aurora-dataplane \
    target/release/aurora-dataplane.d \
    target/release/deps/aurora_dataplane* \
    target/release/.fingerprint/aurora-dataplane-*

# [COMMENT]: Copy toàn bộ source code thực tế và tiến hành biên dịch bản release
COPY proto /src/proto
COPY dataplane /src/dataplane

# [COMMENT]: Force-touch các file .rs để ép Cargo rebuild crate chính với code mới
RUN find src -name "*.rs" -exec touch {} + \
    && cargo build --release --bin aurora-dataplane \
    && test -s target/release/aurora-dataplane

# ============================================================================
# 🚀 STAGE 2: RUNNER - CONTAINER DISTROLESS CC DEBIAN 13 (NON-ROOT)
# ============================================================================
# [COMMENT]: Chuyển sang gcr.io/distroless/cc-debian13:nonroot
# Image này chứa sẵn C runtime library (glibc, libgcc_s1, libssl3, ca-certificates) cần cho Rust & MinIO Client
# đồng thời triệt tiêu hoàn toàn Shell (/bin/sh) và package manager để tăng cường an ninh bảo mật Cloud-Native.
FROM gcr.io/distroless/cc-debian13:nonroot AS runtime

# [COMMENT]: Copy Rust release binary vào thư mục thực thi tiêu chuẩn
COPY --from=builder /src/dataplane/target/release/aurora-dataplane /usr/local/bin/aurora-dataplane

# [COMMENT]: Copy MinIO Client (mc) binary sang runtime distroless
COPY --from=mc-builder /out/mc /usr/local/bin/mc

# [COMMENT]: Đặt thư mục làm việc mặc định cho Dataplane service
WORKDIR /var/lib/dataplane

# [COMMENT]: Thiết lập phân quyền chạy bằng user nonroot (UID 65532:65532) tuân thủ nguyên tắc Least Privilege
USER 65532:65532

# [COMMENT]: Khởi chạy trực tiếp binary mà không cần qua shell wrapper
ENTRYPOINT ["/usr/local/bin/aurora-dataplane"]
