# Job Orchestrator owns this environment contract. PostgreSQL and Shared Redis
# connection records are resolved from capability-scoped Vault paths.
TZ=Asia/Ho_Chi_Minh
APP_ENV=development
DEPLOYMENT_ENVIRONMENT=development
APP_LOG_LEVEL=debug

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_TIMEOUT_SECS=5
VAULT_MAX_RETRIES=5

POSTGRES_APPLICATION_NAME=aurora-job-orchestrator
POSTGRES_TLS_MODE=disable
POSTGRES_CONNECT_TIMEOUT_SECS=5
POSTGRES_TCP_USER_TIMEOUT_MS=15000
POSTGRES_KEEPALIVE_IDLE_SECS=30
POSTGRES_KEEPALIVE_INTERVAL_SECS=10
POSTGRES_KEEPALIVE_RETRIES=3
POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOCK_TIMEOUT_MS=1000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=5000

REPLICATION_SLOT_NAME=outbox_slot
PUBLICATION_NAME=outbox_pub
CDC_SOURCES=mail.mail_outbox_records,hierarchy.zones,hierarchy.zone_services,storage.storage_outbox_records,hypervisor.hypervisor_outbox_records,managed_service.managed_service_outbox_records
CHANGEFEED_BUFFER_EVENTS=128
CHANGEFEED_SHUTDOWN_GRACE_MS=5000

SHARED_REDIS_AOF_REPLICA_ACKS=0
SHARED_REDIS_CONNECT_TIMEOUT_MS=3000
SHARED_REDIS_RESPONSE_TIMEOUT_MS=5000
SHARED_REDIS_AOF_TIMEOUT_MS=2000

# Kafka endpoint, security protocol, client identity and TLS material are
# resolved from the fixed JO Kafka capability record in Vault at startup.
KAFKA_TOPIC_PREFIX=aurora

# NATS Core endpoint, auth and TLS material are resolved from the fixed JO
# NATS capability record in Vault at startup.

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://controlplane-otel-collector:4317
OTEL_TRACE_SAMPLE_RATIO=0.25

# Managed Service result recovery only resets stale delivery markers. The
# protected payload, event identity, generation and delivery epoch remain
# immutable; PostgreSQL WAL/CDC republishes the exact command at next wakeup.
MANAGED_SERVICE_RECONCILE_INTERVAL_SECS=600
MANAGED_SERVICE_RECONCILE_BATCH_SIZE=32
MANAGED_SERVICE_RECONCILE_STALE_SECS=120
