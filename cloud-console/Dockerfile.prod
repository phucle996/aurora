# ============================================================================
# 🐳 STAGE 1: BUILDER - BIÊN DỊCH VÀ XÂY DỰNG ỨNG DỤNG NEXT.JS
# ============================================================================
FROM node:20-alpine AS builder
WORKDIR /app

# [COMMENT]: Khai báo ARG nhận các biến môi trường build-time cho Next.js Client-side.
# Các biến NEXT_PUBLIC_ là công khai nên truyền qua ARG là hoàn toàn an toàn (không chứa dữ liệu nhạy cảm).
ARG NEXT_PUBLIC_ENVOY_URL
ARG NEXT_PUBLIC_CENTRIFUGO_WS_URL

# [COMMENT]: Xuất các ARG thành ENV để trình biên dịch 'next build' có thể nhúng cứng vào JS bundle.
ENV NEXT_PUBLIC_ENVOY_URL=$NEXT_PUBLIC_ENVOY_URL
ENV NEXT_PUBLIC_CENTRIFUGO_WS_URL=$NEXT_PUBLIC_CENTRIFUGO_WS_URL

COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY . .
RUN npm run build

# ============================================================================
# 🐳 STAGE 2: RUNNER - CONTAINER VẬN HÀNH THỰC TẾ SIÊU NHẸ
# ============================================================================
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Sao chép các tệp node_modules đã cài đặt từ builder
COPY --from=builder /app/node_modules ./node_modules
# Sao chép file package.json để chạy lệnh script start
COPY --from=builder /app/package*.json ./
# Sao chép thư mục build của Next.js (.next)
COPY --from=builder /app/.next ./.next
# Sao chép các assets tĩnh trong thư mục public
COPY --from=builder /app/public ./public

# Expose port 3000 phục vụ truy cập
EXPOSE 3000

# Khởi chạy Next.js Server ở chế độ production
CMD ["npm", "run", "start"]
