# syntax=docker/dockerfile:1.7

# ============================================================================
# 🏗️ STAGE 1: BUILDER - BIÊN DỊCH VÀ XÂY DỰNG ỨNG DỤNG NEXT.JS
# ============================================================================
# [COMMENT]: Môi trường Node.js 20 Alpine phục vụ cài đặt dependencies và đóng gói Next.js bundle
FROM node:20-alpine AS builder
WORKDIR /app

# [COMMENT]: Khai báo ARG nhận các biến môi trường build-time cho Next.js Client-side
ARG NEXT_PUBLIC_ENVOY_URL
ARG NEXT_PUBLIC_CENTRIFUGO_WS_URL
ARG NEXT_PUBLIC_COST_CONSOLE_URL

COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY . .
# The app-owned .env is the local source of truth. CI may provide explicit
# build args instead, but every public URL remains required; an empty identity
# must never silently produce a bundle pointed at an unintended origin.
RUN set -eu; \
    if [ -f .env ]; then \
      set -a; . ./.env; set +a; \
    else \
      export NEXT_PUBLIC_ENVOY_URL="$NEXT_PUBLIC_ENVOY_URL"; \
      export NEXT_PUBLIC_CENTRIFUGO_WS_URL="$NEXT_PUBLIC_CENTRIFUGO_WS_URL"; \
      export NEXT_PUBLIC_COST_CONSOLE_URL="$NEXT_PUBLIC_COST_CONSOLE_URL"; \
    fi; \
    : "${NEXT_PUBLIC_ENVOY_URL:?NEXT_PUBLIC_ENVOY_URL is required}"; \
    : "${NEXT_PUBLIC_CENTRIFUGO_WS_URL:?NEXT_PUBLIC_CENTRIFUGO_WS_URL is required}"; \
    : "${NEXT_PUBLIC_COST_CONSOLE_URL:?NEXT_PUBLIC_COST_CONSOLE_URL is required}"; \
    npm run build

# ============================================================================
# 🚀 STAGE 2: RUNNER - DISTROLESS NODEJS 20 DEBIAN 12 (NON-ROOT)
# ============================================================================
# [COMMENT]: Chuyển sang Google Distroless Node.js 20 Debian 12 Non-root
# Loại bỏ toàn bộ Shell, npm package manager và OS utilities khỏi runtime container để đảm bảo an toàn tuyệt đối.
FROM gcr.io/distroless/nodejs20-debian12:nonroot AS runner
WORKDIR /app
ENV NODE_ENV=production

# [COMMENT]: Sao chép node_modules và build assets từ Stage Builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

# [COMMENT]: Chạy dưới phân quyền nonroot user (UID 65532:65532)
USER 65532:65532

# [COMMENT]: Expose port 3000 cho Next.js Web Console
EXPOSE 3000

# [COMMENT]: Khởi chạy trực tiếp Next.js CLI qua Node binary (không qua npm shell wrapper)
CMD ["node_modules/next/dist/bin/next", "start"]
