# Cloud Console development runtime contract. Public values are also supplied
# as required Docker build args because Next.js embeds them in the client bundle.
NEXT_PUBLIC_ENVOY_URL=https://controlplane.aurora.local
NEXT_PUBLIC_CENTRIFUGO_WS_URL=wss://localhost/connection/websocket
NEXT_PUBLIC_COST_CONSOLE_URL=https://cost-manager.aurora.local
NODE_TLS_REJECT_UNAUTHORIZED=0
