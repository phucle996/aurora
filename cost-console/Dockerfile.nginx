# syntax=docker/dockerfile:1.7

# ============================================================================
# 🏗️ STAGE 1: BUILD REACT/VITE SPA
# ============================================================================
# [COMMENT]: Môi trường Node 20 Alpine biên dịch tĩnh bundle React/Vite SPA cho Billing & Cost Console
FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_CLOUD_CONSOLE_URL
COPY package*.json ./
RUN npm ci
COPY . .
# Prefer the Cost Console-owned .env. A CI build may pass the explicit ARG,
# but the public redirect origin is always required and never defaulted.
RUN set -eu; \
    if [ -f .env ]; then \
      set -a; . ./.env; set +a; \
    else \
      export VITE_CLOUD_CONSOLE_URL="$VITE_CLOUD_CONSOLE_URL"; \
    fi; \
    : "${VITE_CLOUD_CONSOLE_URL:?VITE_CLOUD_CONSOLE_URL is required}"; \
    npm run build

# ============================================================================
# 🚀 STAGE 2: PRODUCTION NGINX UNPRIVILEGED (NON-ROOT)
# ============================================================================
# [COMMENT]: Nginx Unprivileged Alpine chính thức của F5/Nginx
# Chạy mặc định dưới phân quyền phi quản trị (user nginx, UID 101), tuân thủ tiêu chuẩn an ninh Cloud-Native
FROM nginxinc/nginx-unprivileged:stable-alpine AS runtime

# [COMMENT]: Copy các tệp tĩnh đã build từ SPA vào Nginx public root
COPY --from=build /app/dist /usr/share/nginx/html

# [COMMENT]: Copy cấu hình Nginx custom hỗ trợ SPA routing và Envoy Gateway proxying
COPY nginx.conf /etc/nginx/conf.d/default.conf

# [COMMENT]: Expose port Cost Console Web (5173)
EXPOSE 5173

# [COMMENT]: Khởi chạy Nginx ở chế độ daemon off
USER 101:101
CMD ["nginx", "-g", "daemon off;"]
